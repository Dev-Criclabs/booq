{
  "name": "booq",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "node tools/lint/banned-patterns.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run",
    "test:zones": "TZ=UTC vitest run && TZ=Asia/Bangkok vitest run",
    "test:db": "vitest run packages/db packages/secrets tests/rls tests/concurrency --passWithNoTests",
    "db:types": "vite-node tools/db-types.run.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  }
}
