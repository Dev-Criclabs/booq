# Names only. Never put a value in this file. Real values live in the hosting provider
# (one set per environment) and, for per club secrets, encrypted in the database.
# See docs/ops/secrets.md.

# --- Environment ---
APP_ENV=                       # local | preview | staging | production
APP_DOMAIN=                    # the shared BOOQ domain (D6). Not known yet. Config, never hard coded
APP_BASE_URL=                  # https URL of this environment. Each club's URL is built from it (club in the path or subdomain, Architect decides)
CLUB_URL_MODE=                 # path | subdomain (Architect decides)

# --- Database (per environment). The Data API is off: no anon or service role key in any app (Security SR-06) ---
# Each deployment sets DATABASE_URL to its own role. Nothing here is shared between apps.
DATABASE_URL=                  # apps/web: role booq_app | apps/worker: role booq_worker | apps/platform: role booq_platform
WORKER_QUEUE_URL=              # apps/worker only: role booq_queue (owns schema graphile_worker). Session pooler or direct, never transaction mode
WORKER_HOUSEKEEPING_CRON=      # e.g. */5 * * * *   (UTC; see docs/ops/worker.md)
WORKER_IMPORT_SWEEP_CRON=      # e.g. */15 * * * *
WORKER_HOLD_RELEASE_TICK_SECONDS=   # e.g. 20 (15 to 30 allowed)
# booq_owner (migrations) is a CI secret that no person knows. It is not an app variable.
# SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY exist only if the Architect keeps Supabase Auth for BOOQ staff sign in (D3).
# The service role key is held only by a staff invite function, if used. Never by an app.

# --- BOOQ staff sign in (D3): email plus a second factor, never LINE ---
PLATFORM_STAFF_MFA_REQUIRED=true
EMAIL_SMTP_HOST=               # sender for invite and reset emails (SPF, DKIM, DMARC on the BOOQ domain)
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=

# --- Per club secrets: encryption (platform level) ---
CLUB_SECRETS_KEY=              # current key
CLUB_SECRETS_KEY_VERSION=

# --- Jobs: Graphile Worker, no HTTP job routes (Security SR-23) ---
# The worker writes platform.worker_heartbeat in the database. An external monitor polls a counts-only health route in apps/platform (docs/ops/worker.md).

# --- Monitoring ---
SENTRY_DSN=
ALERT_WEBHOOK_URL=

# --- Backups (CI/ops only, not the app) ---
BACKUP_BUCKET=
BACKUP_BUCKET_ACCESS_KEY_ID=
BACKUP_BUCKET_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_RECIPIENT=   # public key / age recipient, not secret

# Per club values are NOT here. Each club has its own LINE provider (D7), so these are stored per club:
# LINE provider ID, Messaging API channel secret and access token, LINE Login channel ID and secret,
# LIFF ID, and two Beam key sets (test and live, D32), each with merchant ID, API key and HMAC key.
#
# If production data is ever moved to self-hosted Postgres in Thailand (docs/ops/plan.md, R1),
# the Supabase names above change. Keep them in this one file.
