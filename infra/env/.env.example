# Names only. Never put a value in this file. Real values live in the hosting provider
# (one set per environment) and, for per club secrets, encrypted in the database.
# See docs/ops/secrets.md.

# --- Environment ---
APP_ENV=                       # local | preview | staging | production
APP_DOMAIN=                    # the shared BOOQ domain (D6). Not known yet. Config, never hard coded
APP_BASE_URL=                  # https URL of this environment. Each club's URL is built from it (club in the path or subdomain, Architect decides)
CLUB_URL_MODE=                 # path | subdomain (Architect decides)

# --- Database (per environment). The Data API is off: no anon or service role key in any app (Security SR-06) ---
# Each deployment sets DATABASE_URL to its own role. Nothing here is shared between apps.
DATABASE_URL=                  # apps/web: role booq_app | apps/worker: role booq_worker | apps/platform: role booq_platform
WORKER_QUEUE_URL=              # apps/worker only: role booq_queue (owns schema graphile_worker). Session pooler or direct, never transaction mode
WORKER_HOUSEKEEPING_CRON=      # e.g. */5 * * * *   (UTC; see docs/ops/worker.md)
WORKER_IMPORT_SWEEP_CRON=      # e.g. */15 * * * *
WORKER_HOLD_RELEASE_TICK_SECONDS=   # e.g. 20 (15 to 30 allowed)
WORKER_OFFER_EXPIRY_TICK_SECONDS=   # whole seconds above 0, F08 offer_expiry (waitlist offers past their time). No default; 30 is only an example
WORKER_CLASS_BELOW_MIN_TICK_SECONDS=   # whole seconds above 0, F08 class_below_minimum (alert to front desk). No default; 60 is only an example
WORKER_CLASS_GENERATE_CRON=   # 5 cron fields (UTC), F08 class_generate (fills the booking window with class sessions). No default; a daily run just after Bangkok midnight is `5 17 * * *`, only an example
WORKER_BEAM_RECONCILE_CRON=   # 5 cron fields (UTC), F05 beam_reconcile (pending main). No default; about every 5 minutes is only the F05 design's suggestion
WORKER_PACKAGE_ORDER_EXPIRY_CRON=  # 5 cron fields (UTC), F05 package order expiry and QR image clean-up (pending main). No default
WORKER_RATE_LIMIT_SWEEP_CRON=  # 5 cron fields (UTC), for the rate_limit_sweep task. No default
WORKER_RATE_LIMIT_KEEP_SECONDS= # whole seconds above 0: how long limiter rows are kept. No default
WORKER_PAY_TAP_PRUNE_CRON=     # 5 cron fields (UTC), prunes old pay-tap limiter rows (F03 pay-tap limit, D61). The worker will not start without it. No default
WORKER_PACKAGE_EXPIRE_CRON=    # 5 cron fields (UTC), package_expire (F06). No default. FA 5.4 guidance: every 5 minutes
WORKER_WALLET_EXPIRE_CRON=     # 5 cron fields (UTC), wallet_expire (F06). No default. FA 5.4 guidance: at least once a day
WORKER_SESSION_START_CRON=     # 5 cron fields (UTC), session_start (F06). No default. FA 5.4 guidance: every minute
WORKER_CONSOLE_SWEEP_CRON=     # 5 cron fields (UTC), for the platform console session sweep. No default
WORKER_CONSOLE_SESSION_ABSOLUTE_SECONDS=  # whole seconds, at least the console's absolute session limit (8 hours in code = 28800). No default
# apps/worker LINE sender (F10). None has a default; no value proposed. SECRETS_PRIVATE_KEY (below) and LOCALES_DIR (web section; the worker build must ship locales/ too) are also required here
WORKER_OUTBOX_SENDER_TICK_SECONDS=  # whole seconds above 0: how often the outbox sender runs. No default; 30 is only the F10 design's suggestion
LINE_API_BASE_URL=             # https base of the LINE Messaging API, set per environment so tests can point at the fake LINE
LINE_PUSH_TIMEOUT_MS=          # whole milliseconds above 0: how long one push may take before it counts as a timeout
# apps/web settings, no defaults in code (docs/ops/web.md):
WEB_SESSION_SECONDS=           # e.g. 43200 (12 h, F02 A-14, still open)
WEB_MAX_BODY_BYTES=            # e.g. 65536
WEB_SIGNIN_RATE_LIMIT=         # e.g. 10  } set both or neither; both are REQUIRED before launch (no limit if unset)
WEB_SIGNIN_RATE_WINDOW_SECONDS= # e.g. 60  }
IMPORT_MAX_ROWS=               # e.g. 5000  } set both or neither; with neither the import answers 503 (docs/ops/web.md)
IMPORT_STAGING_HOURS=          # e.g. 24    }
NEXT_PUBLIC_LIFF_FAKE=         # LEAVE UNSET on every hosted deploy. 1 swaps real LIFF for a fake, for local and CI tests only
LOCALES_DIR=                   # folder holding en.json, th.json and pending/ (F13 receipts). Optional in code, but the receipt PDF routes answer 503 without it: REQUIRED for the 7 Dec test. See docs/ops/web.md
WEB_RATE_LIMIT_KEY=             # SECRET. 32+ characters, HMAC key for the limiter. Required whenever the sign-in rate limit is set. No default
# booq_owner (migrations) is a CI secret that no person knows. It is not an app variable.
# SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY exist only if the Architect keeps Supabase Auth for BOOQ staff sign in (D3).
# The service role key is held only by a staff invite function, if used. Never by an app.

# --- BOOQ staff sign in (D3): email plus a second factor, never LINE ---
# apps/platform (docs/ops/platform.md): DATABASE_URL (role booq_platform), plus
PLATFORM_SIGNING_KEY=           # SECRET. 32+ characters. Signs the console session cookie
PLATFORM_MAX_BODY_BYTES=        # whole number above 0
PLATFORM_SIGNIN_RATE_LIMIT=     # } set both or neither; both REQUIRED before the 7 Dec test
PLATFORM_SIGNIN_RATE_WINDOW_SECONDS=  # }
STAFF_INVITE_URL=               # } all three or none; without them console sign-in answers 503
STAFF_INVITE_SIGNING_SECRET=    # } SECRET. 32+ characters, the same value in apps/platform and apps/staff-invite
PLATFORM_BASE_URL=              # } https address of the console itself, base of the staff enrolment link. Required with STAFF_INVITE_URL
# Not env, set by a BOOQ admin in platform.config before the 7 Dec test: console_enrolment_ttl_hours (no default), pay_tap_limit_* (docs/ops/platform.md)
# apps/staff-invite (the only holder of Supabase keys): STAFF_INVITE_SIGNING_SECRET (same value) plus
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # SECRET. Only here
SUPABASE_ANON_KEY=              # public key for the sign-in calls. Only here
PLATFORM_DATABASE_URL=          # role booq_platform
STAFF_INVITE_MAX_SKEW_SECONDS=  # whole number above 0. Starting value 300, review in the security pass (D147)
STAFF_INVITE_MAX_BODY_BYTES=    # whole number above 0. Starting value 4096, review in the security pass (D147)
PLATFORM_STAFF_MFA_REQUIRED=true
EMAIL_SMTP_HOST=               # sender for invite and reset emails (SPF, DKIM, DMARC on the BOOQ domain)
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=

# --- OPERATOR-ONLY, NEVER an app or CI variable (runbook 17, the first-admin command, D163) ---
# Read from the password manager for one run by a named person, then discarded. Listed here so nobody adds them to a project.
#   BOOTSTRAP_DATABASE_URL (role booq_owner), SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, PLATFORM_BASE_URL

# --- Club secrets key pair (D34, D149; docs/ops/secrets.md: create with infra/keys-generate.mjs) ---
SECRETS_PUBLIC_KEY=            # PEM (one line, \n escapes ok). apps/platform and apps/web (writers). Not secret
SECRETS_PRIVATE_KEY=           # SECRET, PEM. apps/web and apps/worker ONLY. Never apps/platform or apps/staff-invite

# --- Jobs: Graphile Worker, no HTTP job routes (Security SR-23) ---
# The worker writes platform.worker_heartbeat in the database. An external monitor polls a counts-only health route in apps/platform (docs/ops/worker.md).

# --- Monitoring ---
HEALTH_TOKEN=                  # apps/platform only: shared token the external monitor sends to the counts-only health route. Required, no default. Rotate if it leaks
SENTRY_DSN=
ALERT_WEBHOOK_URL=

# --- Backups (CI/ops only, not the app) ---
BACKUP_BUCKET=
BACKUP_BUCKET_ACCESS_KEY_ID=
BACKUP_BUCKET_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_RECIPIENT=   # public key / age recipient, not secret

# Per club values are NOT here. Each club has its own LINE provider (D7), so these are stored per club:
# LINE provider ID, Messaging API channel secret and access token, LINE Login channel ID and secret,
# LIFF ID, and two Beam key sets (test and live, D32), each with merchant ID, API key and HMAC key.
#
# If production data is ever moved to self-hosted Postgres in Thailand (docs/ops/plan.md, R1),
# the Supabase names above change. Keep them in this one file.
